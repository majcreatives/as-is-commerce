###############################################################################
# As-Is-Commerce -- PRODUCTION environment template
#
# Copy THIS file to `.env` on the server. Do not copy `.env.example` instead:
# that one is written for a developer and ships `APP_DEBUG=true`,
# `MAIL_MAILER=log`, `SESSION_SECURE_COOKIE=false` and `LOG_LEVEL=debug`, all of
# which are wrong here.
#
#   cp .env.production.example .env
#   php artisan key:generate
#   # then fill every blank below
#   php artisan app:check-environment --strict
#
# That last command must pass before the site is served to anybody. It is not a
# formality: it refuses a deployment that is debug-on, unable to send mail,
# missing its payment keys, or serving its session cookie in the clear. It reads
# configuration and changes nothing, and it never prints a secret.
#
# NEVER commit a filled-in copy of this file, and never paste one into a ticket.
###############################################################################

APP_NAME=As-Is-Commerce

# `production` is what makes the check apply its strict reading. `staging` is
# also treated as public: it is on the internet, and its errors are the ones a
# stranger can find.
APP_ENV=production

APP_KEY=

# FALSE. A stack trace served to whoever triggered an error discloses file
# paths, framework internals and often configuration values. On a site that
# takes payments this is the most common way a deployment is compromised.
APP_DEBUG=false

# https, and the real origin. A wrong APP_URL breaks absolute links, signed
# URLs and Paystack's redirect allowlist at the worst possible moment.
APP_URL=https://REPLACE-WITH-THE-REAL-ORIGIN

# The backend runs in UTC. Ghana local time is applied in presentation only.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# `stack` -> `single` is a plain file on shared hosting, which is what is
# available. Nobody is watching it; see `app:check-environment` for the level
# it warns about.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# `info`, not `debug`. Debug writes request and query detail to disk
# indefinitely, which is expensive and a liability to keep if any of it is
# personal data.
LOG_LEVEL=info

###############################################################################
# Database
#
# A DEDICATED production database. Never the staging schema, and never a
# database whose name could be mistaken for it.
###############################################################################

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

DB_TEST_DATABASE=as_is_commerce_testing

###############################################################################
# State
#
# The database driver for all three. The `array` driver forgets everything at
# the end of the request, which on a platform holding credit balances looks
# exactly like the site losing people's money.
###############################################################################

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# TRUE. The site is served over https; a session cookie sent in the clear lets
# anyone on the same network read it and become that customer, which here means
# their wallet, their orders and their bids.
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

###############################################################################
# Mail
#
# A REAL TRANSPORT. `log` accepts a message, writes it to a file, returns
# normally and delivers nothing -- so the platform would record every order
# receipt, referral reward and password reset as `mail_status = sent` to an
# address nobody was contacted at. The check above fails the deploy on `log`.
###############################################################################

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
# MAIL_ENCRYPTION is spelled this way for the Laravel 11+ mail config.
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=

# The verified sender. Must match the domain the mail provider is authorised
# for, or every message is silently dropped for spam.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

###############################################################################
# Paystack (Ghana) -- LIVE keys
#
# BOTH keys must come from the same dashboard mode. A live secret beside a test
# public key (or the reverse) fails verification at the checkout.
#
# Never enable SMS by adding keys here. The switch is the `sms_enabled`
# setting, and it stays off until Arkesel has approved the sender ID and a
# handset has confirmed a real message.
###############################################################################

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CURRENCY=GHS
PAYSTACK_TIMEOUT=15

SMS_API_KEY=
SMS_SENDER_ID=
SMS_BASE_URL=https://sms.arkesel.com
SMS_TIMEOUT=10

###############################################################################
# Notification email
#
# FALSE unless a persistent worker is genuinely running. The initial production
# target runs cron rather than long-lived processes, and a queued mail job with
# no worker to run it never leaves -- silently, while the notification row
# claims it was sent.
###############################################################################

NOTIFICATIONS_QUEUE_MAIL=false
NOTIFICATIONS_QUEUE=notifications

###############################################################################
# Real-time auction updates
#
# `null` on this hosting. The auction room polls, and polling is authoritative:
# broadcasting only makes a change appear sooner. A Redis or Reverb outage is
# not a commerce outage.
###############################################################################

BROADCAST_CONNECTION=null

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
