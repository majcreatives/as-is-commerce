###############################################################################
# As-Is-Commerce -- STAGING VPS environment template
#
# Use THIS template for the production-shaped staging droplet (see
# docs/STAGING_VPS.md). It is the staging host that can run a persistent queue
# worker and a Reverb broadcast server, which is exactly what the shared-host
# staging cannot. The Hostinger staging stays on `.env.example` semantics
# (database-backed state, BROADCAST_CONNECTION=null); this template is the
# other, deliberate branch.
#
#   cp .env.staging-vps.example .env
#   php artisan key:generate
#   # then fill every blank below
#   php artisan app:check-environment --strict
#
# NEVER commit a filled-in copy. The deployable ships this template, never the
# live `.env`.
###############################################################################

APP_NAME=As-Is-Commerce

# `staging` is treated as public by `app:check-environment --strict` (errors a
# stranger can find, so APP_DEBUG must be false). It is not `production`, which
# is reserved for the live launch and its own controlled operation.
APP_ENV=staging

APP_KEY=

# FALSE. A staging site is on the internet and its errors are findable.
APP_DEBUG=false

# https, and the real origin of the droplet hostname (e.g.
# https://staging.as-is-commerce.gh). Reverb, cookies and signed URLs all read
# this.
APP_URL=https://REPLACE-WITH-THE-STAGING-VPS-ORIGIN

# The backend runs in UTC. Ghana local time is applied in presentation only.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# `info`, not `debug`. A VPS has disk but not unlimited disk; debug fills it
# with request/query detail and is a liability if it is personal data.
LOG_LEVEL=info

###############################################################################
# Database
#
# A dedicated MariaDB on the droplet (11.8.x, the verified matrix). Never the
# shared-host staging schema.
###############################################################################

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=asis_commerce_vps_staging
DB_USERNAME=asis_vps_staging
DB_PASSWORD=

# The separated test schema is used only when the suite runs on this host;
# normally the suite runs on a developer machine against its own testing DB.
DB_TEST_DATABASE=asis_commerce_vps_testing

###############################################################################
# Redis
#
# This template assumes phpredis (`REDIS_CLIENT=phpredis`), the extension
# installed by the runbook. The droplet runs one Redis instance used for the
# cache store, the queue and the broadcast layer underneath Reverb. Sessions
# STAY database-backed on purpose: they are the platform's security boundary,
# and the shared-host configuration they were proved against is the safer
# default to keep.
###############################################################################

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

###############################################################################
# State
#
# Cache and queue move to Redis (the persistent worker reads the queue).
# Sessions deliberately stay database-backed, as above.
###############################################################################

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# TRUE. Served over https; the session cookie is a wallet key.
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

###############################################################################
# Queue
#
# A Supervisor-managed worker runs the notification queue, so queued mail is
# genuinely delivered (nothing is queued by default except communication).
# Financial, inventory and payment work is synchronous and transactional and
# does not depend on this worker -- see AGENTS.md and DEPLOYMENT.md.
###############################################################################

NOTIFICATIONS_QUEUE_MAIL=true
NOTIFICATIONS_QUEUE=notifications

###############################################################################
# Mail
#
# A REAL SMTP transport. `log` accepts a message, writes it to a file and
# delivers nothing. Configure the same provider/account used for staging mail.
###############################################################################

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
# MAIL_ENCRYPTION is spelled this way for the Laravel 11+ mail config.
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=

MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

###############################################################################
# Paystack (Ghana) -- TEST keys on the staging VPS
#
# Both keys must come from the same dashboard mode. Webhook URL configured in
# the Paystack dashboard: https://<staging-origin>/webhooks/paystack
###############################################################################

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CURRENCY=GHS
PAYSTACK_TIMEOUT=15

###############################################################################
# SMS (Arkesel) -- password recovery by text message
#
# Optional on the staging VPS. The switch that enables the channel is the
# `sms_enabled` setting, which is off by default; adding keys does not turn SMS
# on. The sender ID must be registered with Arkesel or the provider rejects
# every request.
###############################################################################

SMS_API_KEY=
SMS_SENDER_ID=
SMS_BASE_URL=https://sms.arkesel.com
SMS_TIMEOUT=10

###############################################################################
# REAL-TIME AUCTION UPDATES (THE POINT OF THE VPS)
#
# BROADCAST_CONNECTION=reverb turns the real-time layer on. The auction room
# polls either way and polling is authoritative -- broadcasting only makes a
# change appear sooner (config/broadcasting.php explains this). A Redis or
# Reverb outage is not a commerce outage.
#
# REVERB_SERVER_* configures the daemon (bind address/port; Supervisor runs
# `php artisan reverb:start`). REVERB_*/VITE_REVERB_* configure how the server
# and the browser reach it. REVERB_APP_KEY is baked into the public JS bundle
# by design (it identifies the app to the socket, it authorises nothing); the
# secret never leaves the server.
###############################################################################

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=REPLACE-WITH-THE-STAGING-ORIGIN-HOST
REVERB_PORT=443
REVERB_SCHEME=https

# Daemon bind. 0.0.0.0 is safe only if the droplet firewall blocks the raw
# port and traffic reaches the server through Nginx TLS (see the runbook).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SERVER_PATH=

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"