<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>

        <!--
            Concurrency tests use a second database connection and therefore
            truncate rather than wrap each test in a transaction. Kept in their
            own suite so that difference is explicit.
        -->
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            The suite outgrew PHP's 128M CLI default. It does not fail a test:
            the process runs out of memory partway through and exits 0, so a
            gate on `php artisan test` reports a pass for a run that never
            finished. Set here rather than documented as a flag because
            `artisan test` spawns Pest as a subprocess, so `php -d` on the
            outer command never reaches it, whereas this reaches every way of
            running the suite. A ceiling, not a measurement: 1G is known to pass.
        -->
        <ini name="memory_limit" value="1G"/>

        <!--
            force="true" everywhere, and a <server> twin for every <env>:
            phpunit's <env> writes only $_ENV and the process environment, but
            `php artisan test` boots the application (loading .env, which lands
            in $_SERVER) before PHPUnit runs, and Laravel's env() consults
            $_SERVER first. Without the <server> mirror, a suite meant for the
            testing database silently runs against the dev one, and the
            sync/array drivers silently become database ones. The exact
            accident this file exists to prevent.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>

        <!--
            Tests run against MySQL, not SQLite.

            Two reasons: this PHP build has no pdo_sqlite extension, and more
            importantly the auction engine will depend on MySQL row-locking
            semantics (SELECT ... FOR UPDATE) that SQLite cannot model. Testing
            on the same engine as production avoids false confidence in exactly
            the area where correctness matters most.

            Requires a schema named by DB_TEST_DATABASE to exist locally.
        -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <server name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="as_is_commerce_testing" force="true"/>
        <server name="DB_DATABASE" value="as_is_commerce_testing" force="true"/>

        <env name="MAIL_MAILER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <server name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <server name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
