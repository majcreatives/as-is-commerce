###############################################################################
# As-Is-Commerce -- example environment
#
# Copy to .env and fill in local values. NEVER put real credentials, API keys
# or passwords in this file: it is committed to source control.
###############################################################################

APP_NAME=As-Is-Commerce
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The backend runs in UTC. Ghana local time (UTC+0) is applied in the
# presentation layer only -- business timestamps are always persisted in UTC.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Database
#
# Create the schema before running migrations:
#   CREATE DATABASE as_is_commerce CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
#   CREATE DATABASE as_is_commerce_testing CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
###############################################################################

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=as_is_commerce
DB_USERNAME=
DB_PASSWORD=

# Separate schema used by the test suite; it is migrated fresh on every run.
DB_TEST_DATABASE=as_is_commerce_testing

###############################################################################
# Local infrastructure
#
# Redis, queue workers and broadcasting are introduced in the auction-engine
# stage. Until then the database/file drivers are sufficient and require no
# additional services.
###############################################################################

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

###############################################################################
# Administrator bootstrap (optional)
#
# Consumed by `php artisan app:create-admin`. Leave blank to be prompted
# interactively instead. Never commit a real value here.
###############################################################################

ADMIN_NAME=
ADMIN_PHONE=
ADMIN_EMAIL=
ADMIN_PASSWORD=

###############################################################################
# Paystack (Ghana)
#
# Server-side credentials. The secret key authenticates API calls and verifies
# webhook signatures -- it must never be sent to the browser, and never
# committed. Test keys (sk_test_/pk_test_) are safe for development.
#
# Automated tests do not require real credentials.
###############################################################################

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CURRENCY=GHS
PAYSTACK_TIMEOUT=15
